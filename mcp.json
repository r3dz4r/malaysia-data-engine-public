{
  "$schema": "https://mcp.data-pulse.my/engine/mcp.schema.json",
  "schema": "malaysia-data-engine/v1/mcp-advertisement",
  "mcp_version": "2026-07-28",
  "server": {
    "name": "malaysia-data-engine-mcp",
    "version": "4ba18c65ed902e08c975fd3a0415dc1278b8cbe2",
    "source_commit_sha": "40d5725158338d667090d00fe76a6eef1c870959",
    "source_commit_date": "2026-09-02",
    "description": "Read-only NPRA pharmaceutical records and pipeline health for Malaysia.",
    "vendor": "Malaysia Data Engine",
    "repository": "https://github.com/r3dz4r/malaysia-data-engine-public"
  },
  "endpoint": {
    "url": "https://mcp.data-pulse.my/engine",
    "transport": "streamable-http",
    "method": "POST",
    "auth_required": false
  },
  "tools": [
    {
      "name": "search_pharma",
      "description": "Search one NPRA category by its public searchable fields.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "q": {
            "description": "Case-insensitive substring to search for.",
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "category": {
            "default": "products",
            "description": "NPRA category to search. Defaults to products.",
            "enum": [
              "products",
              "cancelled",
              "manufacturers",
              "importers",
              "wholesalers"
            ],
            "type": "string"
          },
          "limit": {
            "default": 20,
            "description": "Maximum number of matching products to return. Default 20.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_npra_record",
      "description": "Return one exact NPRA record, searching all categories by default.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "reg_no": {
            "description": "Exact NPRA registration number to look up (e.g. MAL16100027TCR).",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "enum": [
                  "products",
                  "cancelled",
                  "manufacturers",
                  "importers",
                  "wholesalers"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter the lookup to one NPRA category; defaults to searching all categories."
          }
        },
        "required": [
          "reg_no"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "find_recent_changes",
      "description": "Return deduplicated changes from the dated pipeline delta artefacts.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "window_days": {
            "default": 7,
            "description": "Number of days back to include registry changes. Default 7.",
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "category": {
            "anyOf": [
              {
                "enum": [
                  "products",
                  "cancelled",
                  "manufacturers",
                  "importers",
                  "wholesalers"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter changes to one category; all categories by default."
          }
        },
        "required": [],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_pharma_health",
      "description": "Return the pipeline-produced pharma health document verbatim.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "find_by_manufacturer",
      "description": "Find products and related NPRA records for a manufacturer-name substring.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Manufacturer-name substring to search for (case-insensitive).",
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "verify_pharma_artifact",
      "description": "Return the public verification stub for the signed pharma provenance bundle.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}